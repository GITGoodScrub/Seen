{
  "expo": {
    "name": "Seen",
    "owner": "hjalmar3",
    "slug": "Seen",
    "scheme": "seen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/seen_logo_inverted.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/seen_logo_inverted.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/seen_logo_inverted.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/seen_logo_inverted.png"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Seen to add show times to your calendar."
        }
      ]
    ]
  }
}
